{
  "name": "site-express",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page Site Express 48H",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --watch",
    "build:js": "esbuild src/main.ts --bundle --outfile=js/app.js --minify --sourcemap",
    "watch:js": "esbuild src/main.ts --bundle --outfile=js/app.js --watch",
    "build": "npm run build:css && npm run build:js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
